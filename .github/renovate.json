{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 6am every weekday"],
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "commitMessagePrefix": "⬆️",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile\\.template$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) registryUrl=(?<registryUrl>\\S+)\\s+ARG \\S+_VERSION=\"(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "{{{datasource}}}",
      "registryUrlTemplate": "{{{registryUrl}}}"
    }
  ],
  "packageRules": [
    {
      "matchDatasources": ["deb"],
      "groupName": "Cog and WPE runtime",
      "groupSlug": "cog-wpe-runtime",
      "addLabels": ["docker", "deploy-pr"],
      "automerge": false
    },
    {
      "matchManagers": ["gomod"],
      "addLabels": ["go"],
      "automerge": false
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "rangeStrategy": "pin",
      "addLabels": ["python"],
      "automerge": false
    },
    {
      "matchManagers": ["pep621"],
      "matchDepTypes": ["dependency-groups"],
      "groupName": "python dev dependencies",
      "groupSlug": "python-dev-dependencies"
    },
    {
      "matchManagers": ["dockerfile"],
      "addLabels": ["docker"],
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "addLabels": ["github_actions"],
      "rangeStrategy": "pin",
      "extractVersion": "^(?<version>v\\d+\\.\\d+\\.\\d+)$",
      "versioning": "regex:^v(?<major>\\d+)(\\.(?<minor>\\d+)\\.(?<patch>\\d+))?$"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "groupSlug": "github-actions",
      "automerge": true
    },
    {
      "matchManagers": ["dockerfile", "gomod", "pep621"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    }
  ],
  "docker-compose": {
    "enabled": false
  }
}
